{
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/copy-html-template.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/seo?type=robots" },
    { "source": "/sitemap.xml", "destination": "/api/seo?type=sitemap" },
    { "source": "/:path*", "destination": "/api/seo?path=:path*" }
  ]
}
